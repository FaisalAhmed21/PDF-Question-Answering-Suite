# LLM
GROQ_API_KEY=
GEMINI_API_KEY=

LLM_PROVIDER=groq
LLM_FALLBACK_PROVIDER=gemini
LLM_MODEL=llama-3.3-70b-versatile
LLM_FALLBACK_MODEL=gemini-2.0-flash

# Embeddings
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384

# PDF
PDF_PARSER=auto

# Retrieval
HYBRID_ENABLED=true
RERANK_ENABLED=true
RERANK_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
RELEVANCE_THRESHOLD=0.35
RERANK_THRESHOLD=0.05

# Features
GROUNDEDNESS_ENABLED=true
AGENTIC_ENABLED=true
CONTEXTUAL_RETRIEVAL_LLM=true
HYDE_ENABLED=false

# Database (relative paths resolve to project root)
DATABASE_URL=sqlite+aiosqlite:///./ragchatbot.db

# Qdrant — set QDRANT_URL for cloud; otherwise local path is used
QDRANT_PATH=./qdrant_data
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=document_chunks

# Server
BACKEND_CORS_ORIGINS=http://localhost:3000
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=50
